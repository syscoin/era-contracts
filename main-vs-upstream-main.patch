+                let i := 0
+            } lt(i, chunks) {
+                i := add(i, 0x20)
+            } {
+                mstore(add(dstPtr, i), mload(add(srcPtr, i)))
+            }
+
+            // tail
+            let rem := and(len, 31)
+            if rem {
+                let tailDst := add(dstPtr, chunks)
+                let tailSrc := add(srcPtr, chunks)
+
